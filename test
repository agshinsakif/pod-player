def safe_filename(title):
    value = str(title or "").strip()
    value = re.sub(r'[<>:"/\\|?*\x00-\x1f]', " - ", value)
    value = re.sub(r"\s+", " ", value).strip(" .")
    return value or "untitled"

def rclone_check_vtt(show_id, title):
    safe_title = safe_filename(title)
    remote_dir = f"r2:pod-player/episodes/{show_id}/"
    res = subprocess.run(
        ["rclone", "lsf", "--s3-no-check-bucket", remote_dir],
        capture_output=True,
        text=True,
    )
    if res.returncode != 0:
        return False
    return any(
        name.startswith(safe_title) and name.lower().endswith(".vtt")
        for name in res.stdout.splitlines()
    )

